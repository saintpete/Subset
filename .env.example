# Copy to .env (git-ignored). Values here are read at startup; real
# environment variables win over this file.

# Password from OBS → Tools → WebSocket Server Settings
OBS_WS_PASSWORD=change-me

# Optional: default transcription engine (gemini | deepgram)
# SUBSET_ENGINE=deepgram

# Optional: obs-websocket URL if not the default
# OBS_WS_URL=ws://127.0.0.1:4455
